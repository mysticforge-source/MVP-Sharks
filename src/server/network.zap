opt typescript = true
opt server_output = "./network/server.luau"
opt client_output = "../client/network/client.luau"
opt types_output = "../shared/networktypes.luau"

opt call_default = "ManyAsync"
opt casing = "camelCase"

opt include_profile_labels = true
--opt async_lib = "require(game:GetService('ReplicatedStorage').rbxts_include.RuntimeLib)"

-- !!! zap src/server/network.zap

-- ====================================================================================
-- TYPES

--[[
    Player in-game data and data of shark slots
]]
type SharkSlot = struct { 
    shark: u8,

    alive: boolean,
    created: boolean,

    hp: u8(0..100),
    maxhp: u8(0..100),

    hunger: u8(0..100),
    maxhunger: u8(0..100),

    exp: u8(0..100),
    maxexp: u8(0..100),

    upgrade: u8(0..3), --0 is default; 3 is max
    level: u8,
    -- title size damage speed are from shared
}

--[[
    UserData type is generated by Zap within definition files
]]
type UserData = struct {
    -- sharkcoins
    coins: u32(..100000), --100,000; 4,294,967,295
    sharkcoins: u16, --65,535
    revivetokens: u8,

    ownedsharks: u8[],

    -- zap uses luau-based indexing so 0..3 is 3 elements
    slots: SharkSlot[3],
}

-- ====================================================================================
-- EVENTS

event PlayerDataEvent = {
    from: Server,
    type: Reliable,
    data: UserData
}

-- Minimizing
event IngameDataEvent = {
    from: Server,
    type: Reliable,
    data: SharkSlot
}

-- Create a new slot and enter the game
event SpawnSlot = {
    from: Client,
    type: Reliable,
    data: struct {slot: u8, shark: u8}, 
    -- slot must not be created & shark must be owned
}

event SpawnResult = {
    from: Server,
    type: Reliable
}

event BuyUpgrade = {
    from: Client,
    type: Reliable
}
